# ============================================================
# IQS (Intelligent QC Studio) — 运行环境配置
# ============================================================
# 使用方法: 复制为 .env 文件，填入实际值
#   cp .env.example .env
#   docker compose up -d
# ============================================================

# 【必填】AI 服务全局 API 密钥（R33 安全加固：仅驻留服务端内存，绝不下发至前端浏览器产物）
# 替换为您自己的 API Key (DeepSeek / 其他 AI 服务商)
API_KEY=your-actual-api-key-here

# 【可选】默认激活的 AI 配置方案（首次启动尚未生成 data/ai_config.json 时生效）
# 对应 public/config.json 中的 profiles 项
# 可选值: deepseek_public, local_qwen, client_cookie
AI_ACTIVE_PROFILE=deepseek_public

# 【强烈建议生产环境修改】大模型接入管理中心管理密码（服务端常量时间校验 + HttpOnly 会话 Cookie）
# 未设置时回退为: luxi2026
IQS_ADMIN_PASSWORD=luxi2026

# Web UI + API (:12000) · MCP SSE + Renders (:12001)
WEB_PORT=12000
PORT=12001
IQS_BASE_URL=http://localhost:12000

# 【可选】服务端持久化数据目录（存储管理端修改的 ai_config.json）
IQS_DATA_DIR=./data

# 【可选】MCP 渲染图片自动垃圾回收策略（仅清理过期或超量的 render_*.png）
IQS_RENDER_TTL_HOURS=24
IQS_RENDER_MAX_FILES=500

# 【可选】容器内 Chromium 沙箱开关（标准 Docker 未授予 SYS_ADMIN 时需保持 true；若宿主机已配置 seccomp/userns 可设为 false）
IQS_CHROMIUM_NO_SANDBOX=true

# 【可选】MCP 服务外部访问基准地址 (解决容器部署与反向代理场景下的图表图片链接可达性)
# - 若通过域名或反向代理访问，建议填写: https://qc.yourdomain.com
# - 若通过宿主机 IP 直连访问，可填写: http://192.168.1.100:12001
# - 若留空，服务将自动根据客户端请求标头 (X-Forwarded-Proto / X-Forwarded-Host) 动态推导
# 【可选】反向代理信任策略 (默认仅信任回环地址与私有局域网网段)
# - 若外层有多层代理，可设置跳数，如: 1 或 2
# - 若信任全部前置反代，可设置: true
# - 语法与 Express trust proxy 保持一致 (true | false | 跳数 | 子网)
# IQS_TRUST_PROXY=

