# ============================================================
# IQS (Intelligent QC Studio) — 运行环境配置
# ============================================================
# 使用方法: 复制为 .env 文件，填入实际值
#   cp .env.example .env
#   docker compose up -d
# ============================================================

# 【必填】AI 服务 API 密钥
# 替换为您自己的 API Key (DeepSeek / 其他 AI 服务商)
API_KEY=your-actual-api-key-here

# 【可选】激活的 AI 配置方案
# 对应 public/config.json 中的 profiles 项
# 可选值: deepseek_public (deepseek-v4-flash), local_qwen (qwen3.5-9b)
AI_ACTIVE_PROFILE=deepseek_public

# Web :12000 · MCP SSE :12001（npm run 与 Docker 默认一致）
IQS_BASE_URL=http://localhost:12000
PORT=12001

# 【可选】MCP 服务外部访问基准地址 (解决容器部署与反向代理场景下的图表图片链接可达性)
# - 若通过域名或反向代理访问，建议填写: https://qc.yourdomain.com
# - 若通过宿主机 IP 直连访问，可填写: http://192.168.1.100:12001
# - 若留空，服务将自动根据客户端请求标头 (X-Forwarded-Proto / X-Forwarded-Host) 动态推导
# 【可选】反向代理信任策略 (默认仅信任回环地址与私有局域网网段)
# - 若外层有多层代理，可设置跳数，如: 1 或 2
# - 若信任全部前置反代，可设置: true
# - 语法与 Express trust proxy 保持一致 (true | false | 跳数 | 子网)
# IQS_TRUST_PROXY=

