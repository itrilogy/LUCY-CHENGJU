{
  "name": "chengju-iqs",
  "private": true,
  "version": "3.5.3-ildr",
  "description": "澄矩 · ChengJu (IQS) - 工业智能质量控制工作站 · 鹿溪联合创新实验室",
  "author": "江西省上饶市烟草专卖局（公司）信息中心",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "sync-tools": "cp mcp-server/mcp_tools.json public/mcp_tools.json",
    "validate:dsl": "node scripts/validate_dsl.mjs && node --experimental-strip-types scripts/lint_examples.ts && node --experimental-strip-types scripts/assert_card_contracts.ts",
    "build:cards": "node --experimental-strip-types scripts/build_cards.ts",
    "validate:cards": "node --experimental-strip-types scripts/validate_cards.ts",
    "check:cards-fresh": "node --experimental-strip-types scripts/check_cards_fresh.ts",
    "snapshot:cards": "node --experimental-strip-types scripts/validate_cards.ts --update-snapshots",
    "scaffold:cards": "node --experimental-strip-types scripts/scaffold_cards.ts",
    "test:fishbone": "node --experimental-strip-types scripts/assert_fishbone_math.ts",
    "test:relation": "node --experimental-strip-types scripts/assert_relation_math.ts",
    "test:pdpc": "node --experimental-strip-types scripts/assert_pdpc_math.ts",
    "test:flow": "node --experimental-strip-types scripts/assert_flow_parser.ts && node --experimental-strip-types scripts/assert_flow_svg.ts && node --experimental-strip-types scripts/assert_flow_bpmn.ts && node --experimental-strip-types scripts/assert_mainline.ts && node --experimental-strip-types scripts/assert_cell_order.ts && node --experimental-strip-types scripts/assert_flow_alignment.ts && node --experimental-strip-types scripts/assert_flow_geometry.ts",
    "dev": "npm run sync-tools && vite --port 12000 --host 0.0.0.0 --strictPort",
    "build:mcp-lint": "esbuild scripts/flow_lint_core.ts --bundle --platform=node --format=esm --target=node22 --outfile=mcp-server/lib/flow_lint.mjs --log-level=warning",
    "check:mcp-lint-fresh": "node --experimental-strip-types scripts/check_mcp_lint_fresh.ts",
    "build": "npm run validate:dsl && npm run test:fishbone && npm run test:relation && npm run test:pdpc && npm run test:flow && npm run sync-tools && npm run build:mcp-lint && npm run check:mcp-lint-fresh && vite build",
    "preview": "vite preview --port 12000 --host 0.0.0.0 --strictPort",
    "mcp:stdio": "IQS_BASE_URL=${IQS_BASE_URL:-http://localhost:12000} node mcp-server/index.js",
    "mcp:sse": "IQS_BASE_URL=${IQS_BASE_URL:-http://localhost:12000} PORT=${PORT:-12001} node mcp-server/index.js --transport=sse"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@modelcontextprotocol/sdk": "^1.6.0",
    "@visactor/react-vchart": "^2.0.19",
    "@visactor/vchart": "^2.0.19",
    "clsx": "2.1.1",
    "cors": "^2.8.5",
    "echarts": "5.5.1",
    "echarts-for-react": "3.0.6",
    "echarts-gl": "2.0.9",
    "express": "^4.19.2",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.0",
    "lucide-react": "0.563.0",
    "mermaid": "^11.12.3",
    "puppeteer": "^24.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  }
}
